# Web env example
# Copy to web/.env.local for local development.

# NEAR network and contract
NEXT_PUBLIC_NEAR_NETWORK_ID=testnet
NEXT_PUBLIC_NEAR_CONTRACT_ID=nearena-v1.testnet

# Solana network used in UI flows
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Backend base URL for API calls (faucet, solana-derived player)
# Local dev:
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787

# NEAR read-only proxy endpoint consumed by the frontend.
# Local dev with backend server:
NEXT_PUBLIC_NEAR_RPC_PROXY_PATH=http://localhost:8787/v1/near-rpc

# Production example (GitHub Pages + public backend):
# NEXT_PUBLIC_BACKEND_URL=https://api.your-domain.com
# NEXT_PUBLIC_NEAR_RPC_PROXY_PATH=https://api.your-domain.com/v1/near-rpc
