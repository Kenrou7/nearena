# NEAR AI Cloud (https://cloud.near.ai → Credits → API Keys). OpenAI-compatible API.
NEAR_AI_API_KEY=
# Any model with "tools" support listed by GET https://cloud-api.near.ai/v1/models
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

# NEAR testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_NETWORK_ID=testnet
GAME_CONTRACT_ID=nearena-v1.testnet
# Bot account: a regular player account (never the contract owner).
BOT_ACCOUNT_ID=
BOT_PRIVATE_KEY=ed25519:

# Loop
MAX_TURNS=10
TURN_DELAY_MS=3000
