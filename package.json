{
  "name": "gladiator",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "web",
    "backend",
    "agent",
    "scripts",
    "packages/shared-types"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "pm2:start": "pm2 start ecosystem.config.cjs --only gladiator-backend",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --only gladiator-backend",
    "pm2:stop": "pm2 stop ecosystem.config.cjs --only gladiator-backend",
    "pm2:delete": "pm2 delete ecosystem.config.cjs --only gladiator-backend",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs gladiator-backend"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "pm2": "^5.4.3"
  }
}