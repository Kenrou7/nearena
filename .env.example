# Root env for Gladiator MVP (shared defaults)
# Copy to .env and fill required values.

# -------- Chain Signatures Spike (scripts) --------
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_NETWORK_ID=testnet

# Commonly used in examples; verify against official docs/current environment.
NEAR_MPC_CONTRACT_ID=v1.signer-prod.testnet

# Required: funded testnet account used by relayer/spike calls.
NEAR_SIGNER_ACCOUNT_ID=your-signer-account.testnet

# Required secret: format must be ed25519:...
NEAR_SIGNER_PRIVATE_KEY=ed25519:REPLACE_ME

# Optional overrides
CHAIN_SIGNATURES_PUBLIC_KEY_METHOD=derived_public_key
CHAIN_SIGNATURES_SIGN_METHOD=sign
CHAIN_SIGNATURES_DOMAIN_ID=1

# -------- Testnet Game Contract Bootstrap --------
NETWORK_NAME=testnet
SIGNER_ACCOUNT_ID=nearena.testnet
BENEFICIARY_ACCOUNT_ID=nearena.testnet
CONTRACT_ACCOUNT_ID=nearena-v1.testnet
OWNER_ID=nearena.testnet
RELAYER_ACCOUNT_ID=nearena.testnet
PLAYER_ACCOUNT_ID=nearena.testnet
INITIAL_BALANCE_NEAR=3

# -------- Optional Solana -> MPC -> NEAR player bootstrap --------
ENABLE_SOLANA_MPC_PLAYER=true
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=scripts/.tmp/solana-devnet-player.json
SOLANA_AIRDROP_AMOUNT=1
IMPLICIT_ACCOUNT_FUNDING_NEAR=0.05 NEAR
MPC_ADMIN_ACCOUNT_ID=nearena.testnet
MPC_DERIVATION_PREFIX=solana
MPC_PUBLIC_KEY_METHOD=derived_public_key
MPC_SIGN_GAS=120 Tgas
MPC_SIGN_DEPOSIT=1 yoctonear
